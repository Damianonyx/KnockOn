# KnockOn local configuration. Copy to .env when setting up another machine.
# Paste file CONTENTS between the quotes, not file paths.

# Hosted Postgres connection string (Vercel: added automatically when you
# connect a Neon database under Storage). Leave empty to use the embedded
# database below.
DATABASE_URL=""

# Embedded Postgres (PGlite) data folder, used only when DATABASE_URL is empty.
# Created automatically on first run.
KNOCKON_DATABASE_PATH="./data/pglite"

# Contents of license.txt. The Univer Web SDK uses this license.
UNIVER_LICENSE=""

# Contents of licenseKey.txt. Used with the license for Univer server features.
# Keep this value on the server.
UNIVER_LICENSE_KEY=""

# Your AntLing API key. Keep this value on the server.
ANTLING_API_KEY=""
ANTLING_BASE_URL="https://api.ant-ling.com/v1"

# Official Ling 3.2 Flash API model ID, confirmed November 6, 2026.
# No automatic fallback to another model.
ANTLING_MODEL="Ling-3.2-flash"

# Optional: Explain limits (defaults 10, 30, 300). See SETUP.md, "Privacy and limits".
# EXPLAIN_LIMIT_PER_VISITOR_PER_HOUR=10
# EXPLAIN_LIMIT_PER_NETWORK_PER_HOUR=30
# EXPLAIN_LIMIT_SITE_PER_DAY=300
